  "clues": [
    { "id": "C_shutter_barred", "text": "The shutters are barred with a heavy iron bar. Nobody could open them from outside.",
      "source": { "type": "inspect", "object": "shutter_middle" }, "core": true },
    { "id": "C_vent_inner", "text": "A small ventilator opens into Dr. Roylott's room, not to the outside air. It looks recent.",
      "source": { "type": "inspect", "object": "ventilator" }, "core": true },
    { "id": "C_rope_dummy", "text": "The bell-rope is new. It hangs from a hook just above the ventilator and is tied to no wire.",
      "source": { "type": "inspect", "object": "bell_rope" }, "core": true },
    { "id": "C_rope_no_bell", "text": "You pull the rope. No bell rings anywhere in the house.",
      "source": { "type": "test", "object": "bell_rope" }, "core": true },
    { "id": "C_bed_clamped", "text": "The bed is clamped to the floor, right under the rope. It cannot be moved.",
      "source": { "type": "inspect", "object": "bed_middle" }, "core": true },
    { "id": "C_chair_marks", "text": "Boot marks on the seat of the wooden chair under the ventilator. Someone stands on it.",
      "source": { "type": "inspect", "object": "chair_roylott" }, "core": true },
    { "id": "C_safe_iron", "text": "A heavy iron safe. Dr. Roylott says it holds only business papers.",
      "source": { "type": "inspect", "object": "safe" }, "core": true },
    { "id": "C_saucer_milk", "text": "A saucer of milk on top of the safe. There is no cat in the house.",
      "source": { "type": "inspect", "object": "saucer" }, "core": true },
    { "id": "C_lash_loop", "text": "A small dog lash on the bed. Its end is tied into a loop of whipcord.",
      "source": { "type": "inspect", "object": "dog_lash" }, "core": true }
  ],
  "testimonies": [
    { "witness": "helen", "topic": "night_of_julias_death",
      "claims": [
        { "event": "E03", "basis": "perceived", "as": "I heard her key turn in the lock." },
        { "event": "E12", "basis": "perceived", "as": "A wild scream, a woman's." },
        { "event": "E14", "basis": "perceived", "as": "As I opened my door, a low whistle." },
        { "event": "E16", "basis": "perceived", "as": "Then a clanging sound, as if metal had fallen." },
        { "event": "E17", "basis": "perceived", "as": "Her door unlocked." },
        { "event": "E18", "basis": "perceived", "as": "She staggered out, white with terror." },
        { "event": "E19", "basis": "perceived", "as": "\"The speckled band!\"" },
        { "event": "E20", "basis": "perceived", "as": "She pointed toward the doctor's room." },
        { "event": "E21", "basis": "perceived", "as": "She fell, and never spoke again." },
        { "event": "E22", "basis": "perceived", "as": "My stepfather came out in his dressing-gown." },
        { "actor": "gipsies", "verb": "whistle", "place": "lawn", "basis": "guess", "as": "Perhaps the gipsies on the lawn?" }
      ] }
  ]
