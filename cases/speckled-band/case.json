      { "id": "weapon", "ask": "What killed her?",
        "options": [
          { "id": "adder", "text": "A swamp adder: the speckled band", "correct": true },
          { "id": "poison", "text": "Poison in her food", "hint": "She was fine at bed. Something came in the night. Check the books in Roylott's room." },
          { "id": "fright", "text": "Nothing. She died of fright", "hypothesis": "H_fright",
            "hint": "She named something with her last words, and someone whistled." }
