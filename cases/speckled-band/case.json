      { "id": "path", "ask": "Her door was locked and the shutters barred. How did it reach her?",
        "options": [
          { "id": "vent", "text": "Through the vent and down the rope to the bed", "correct": true },
          { "id": "window", "text": "Through the window", "hint": "Inspect the shutters in Julia's room." },
