  "clues": [
    { "id": "C_shutter_barred", "title": "Barred shutters", "text": "The shutters are barred with a heavy iron bar. Nobody could open them from outside.",
      "source": { "type": "inspect", "object": "shutter_middle" }, "core": true },
    { "id": "C_vent_inner", "title": "Vent to Roylott's room", "text": "A small ventilator opens into Dr. Roylott's room, not to the outside air. It looks recent.",
      "source": { "type": "inspect", "object": "ventilator" }, "core": true },
    { "id": "C_rope_dummy", "title": "Dummy bell-rope", "text": "The bell-rope is new. It hangs from a hook just above the ventilator and is tied to no wire.",
      "source": { "type": "inspect", "object": "bell_rope" }, "core": true },
    { "id": "C_rope_no_bell", "title": "Rope rings no bell", "text": "You pull the rope. No bell rings anywhere in the house.",
      "source": { "type": "test", "object": "bell_rope" }, "core": true },
    { "id": "C_bed_clamped", "title": "Bed clamped under rope", "text": "The bed is clamped to the floor, right under the rope. It cannot be moved.",
      "source": { "type": "inspect", "object": "bed_middle" }, "core": true },
    { "id": "C_chair_marks", "title": "Boot marks on chair", "text": "Boot marks on the seat of the wooden chair under the ventilator. Someone stands on it.",
      "source": { "type": "inspect", "object": "chair_roylott" }, "core": true },
    { "id": "C_safe_iron", "title": "Iron safe", "text": "A heavy iron safe. Dr. Roylott says it holds only business papers.",
      "source": { "type": "inspect", "object": "safe" }, "core": true },
    { "id": "C_saucer_milk", "title": "Saucer of milk", "text": "A saucer of milk on top of the safe. There is no cat in the house.",
      "source": { "type": "inspect", "object": "saucer" }, "core": true },
    { "id": "C_lash_loop", "title": "Looped dog lash", "text": "A small dog lash on the bed. Its end is tied into a loop of whipcord.",
      "source": { "type": "inspect", "object": "dog_lash" }, "core": true },
    { "id": "C_ref_adder", "title": "The swamp adder", "text": "Fauna book, bookmarked: the swamp adder of India. It can be trained to come back to a whistle, it drinks milk, and its bite kills in seconds, leaving only two tiny marks.",
      "source": { "type": "reference", "object": "fauna_book", "reference": "R_swamp_adder" }, "core": true },
    { "id": "C_door_locked", "title": "Julia locked her door", "text": "Helen heard Julia turn the key in her lock before bed.",
      "source": { "type": "testimony", "witness": "helen", "event": "E03" }, "core": true },
    { "id": "C_whistle", "title": "A low whistle", "text": "Helen heard a low whistle in the night, after the scream.",
      "source": { "type": "testimony", "witness": "helen", "event": "E14" }, "core": true },
    { "id": "C_clang", "title": "A metal clang", "text": "Then a clang, as if metal had fallen. Like a heavy door shutting?",
      "source": { "type": "testimony", "witness": "helen", "event": "E16" }, "core": true },
    { "id": "C_band", "title": "\"The speckled band!\"", "text": "Julia's last words: \"It was the band! The speckled band!\"",
      "source": { "type": "testimony", "witness": "helen", "event": "E19" }, "core": true },
    { "id": "C_pointed", "title": "She pointed at his room", "text": "Dying, Julia pointed toward the doctor's room.",
      "source": { "type": "testimony", "witness": "helen", "event": "E20" }, "core": true }
  ],
  "references": [
